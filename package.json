{
  "name": "ph-ink",
  "version": "0.0.1",
  "description": "A free, open-source link shortener with analytics and QR codes.",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "npm run web:build && wrangler dev",
    "web:build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:access": "node scripts/access-test.mjs",
    "test:abuse": "node scripts/abuse-test.mjs",
    "test:admin": "node scripts/admin-test.mjs",
        "test:login": "node scripts/login-test.mjs",
            "test:blocklist": "node scripts/blocklist-test.mjs",
               "test:clean": "node scripts/clean-test-data.mjs",
        "test:turnstile": "node scripts/turnstile-test.mjs",
            "test:headers": "node scripts/headers-test.mjs",
        "test:all": "npm run test:clean && npm run test:access && npm run test:abuse && npm run test:admin && npm run test:blocklist && npm run test:login && npm run test:turnstile && npm run test:headers"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "hono": "^4.13.16",
    "qr-code-styling": "^1.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tailwindcss/vite": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
